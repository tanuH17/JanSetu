# JanSetu Frontend Environment Variables
# Copy this file to .env.local or .env in JanSetu/client and fill in your Supabase project values

# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public Key (Project Settings -> API -> Project API keys -> anon public)
# IMPORTANT: ONLY use the anon public key here. NEVER use the service_role key in frontend code!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional application metadata
VITE_APP_NAME=JanSetu
VITE_APP_ENV=development
